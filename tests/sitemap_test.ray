import std/deflate;
import sitemap;

const URLSET: string = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>http://h/a</loc><lastmod>2026-01-02</lastmod></url>
  <url><loc>
    http://h/b?x=1&amp;y=2
  </loc></url>
  <url><lastmod>2026</lastmod></url>
</urlset>`;

const INDEX: string = `<?xml version="1.0"?>
<sm:sitemapindex xmlns:sm="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sm:sitemap><sm:loc>http://h/s1.xml</sm:loc></sm:sitemap>
  <sm:sitemap><sm:loc>http://h/s2.xml.gz</sm:loc></sm:sitemap>
</sm:sitemapindex>`;

@test
fn parses_urlset() {
    let s = sitemap.parse(URLSET.to_bytes()).unwrap();
    assert(!s.is_index);
    assert_eq(s.entries.len(), 2);
    assert_eq(s.entries[0].loc, "http://h/a");
    assert_eq(s.entries[0].lastmod, "2026-01-02");
    assert_eq(s.entries[1].loc, "http://h/b?x=1&y=2");
}

@test
fn parses_index_with_prefix() {
    let s = sitemap.parse(INDEX.to_bytes()).unwrap();
    assert(s.is_index);
    assert_eq(
        s.entries.map(fn(e: sitemap.Entry) -> string { e.loc }),
        ["http://h/s1.xml", "http://h/s2.xml.gz"]
    );
}

@test
fn parses_gzipped() {
    let gz = deflate.gzip_compress(URLSET.to_bytes());
    assert(sitemap.is_gzip(gz));
    let s = sitemap.parse(gz).unwrap();
    assert_eq(s.entries.len(), 2);
}

@test
fn plain_text_sitemap() {
    let s = sitemap.parse("http://h/1\n\nhttp://h/2\r\nnot a url\n".to_bytes()).unwrap();
    assert_eq(s.entries.len(), 2);
    assert_eq(s.entries[1].loc, "http://h/2");
}

@test
fn rejects_garbage() {
    assert(sitemap.parse("<html><body/></html>".to_bytes()).is_err());
    assert(sitemap.parse("<urlset><url>".to_bytes()).is_err());
    assert(sitemap.parse(bytes_of([0x1F, 0x8B, 0x00, 0x01])).is_err());
    assert(sitemap.parse("<!DOCTYPE x [<!ENTITY e SYSTEM 'file:///etc/passwd'>]><urlset/>".to_bytes())
        .is_err());
}
